# Banco. Em produção use o Postgres (ex: o mesmo do ETL):
#   postgresql+psycopg2://usuario:senha@host:5432/banco
# Sem essa variável o app usa um SQLite local (pix.db) — só pra teste.
DATABASE_URL=

# Chave para assinar o cookie de sessão. Gere uma com:
#   py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# API de validação do GPS Pay (mesmos valores de GPS_PAY_VALIDACAO / GPS_PAY_TOKEN do config_geral)
GPS_PAY_URL=
GPS_PAY_TOKEN=

# Opcional: avisa no Teams quando um lote termina
TEAMS_WEBHOOK=

# Limite mensal de validações que um usuário novo recebe (o admin ajusta por usuário depois)
LIMITE_MENSAL_PADRAO=500

# Trava extra: máximo de linhas aceitas num único arquivo
MAX_LINHAS_ARQUIVO=5000

# Chamadas simultâneas à API do GPS Pay
WORKERS_API=5

# true em produção (HTTPS) — o cookie de sessão só trafega por HTTPS
COOKIE_SEGURO=false
